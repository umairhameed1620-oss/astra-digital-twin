{
  "name": "astra-backend",
  "version": "2.0.0",
  "description": "ASTRA Enterprise Backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit",
    "test:load": "k6 run tests/load/simulation.js",
    "lint": "eslint . --ext .js",
    "migrate": "node utils/migrate.js",
    "migrate:rollback": "node utils/migrate.js rollback"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "socket.io": "^4.6.1",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.2.0",
    "uuid": "^9.0.0",
    "satellite.js": "^5.0.0",
    "@anthropic-ai/sdk": "^0.27.0",
    "zod": "^3.22.4",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "ioredis": "^5.3.2",
    "bull": "^4.12.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@sentry/node": "^7.99.0",
    "express-async-errors": "^3.1.1",
    "xss": "^1.0.14",
    "hpp": "^0.2.3",
    "express-mongo-sanitize": "^2.2.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.0",
    "response-time": "^2.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "@playwright/test": "^1.40.0",
    "eslint": "^8.56.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "collectCoverageFrom": ["**/*.js", "!**/node_modules/**", "!**/tests/**", "!jest.config.js"],
    "coverageThreshold": { "global": { "branches": 70, "functions": 70, "lines": 70, "statements": 70 } }
  }
}
