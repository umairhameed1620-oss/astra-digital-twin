# ASTRA configuration. Copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -hex 32

# ---- Database / cache (required) ----
DB_USER=astra
DB_PASSWORD=change-me-openssl-rand-hex-16
DB_NAME=astra
REDIS_PASSWORD=change-me-openssl-rand-hex-16

# ---- Authentication (required) ----
# At least 32 random characters. The backend refuses to start without it.
JWT_SECRET=change-me-openssl-rand-hex-32
JWT_EXPIRES_IN=12h
# Comma-separated emails that are made admin when they register or log in.
ADMIN_EMAILS=you@yourcompany.com
# Set to false to stop new teams signing up; invited colleagues can still join with their invitation link.
ALLOW_REGISTRATION=true
# Key that encrypts two-factor secrets. Set it once and keep it: if it changes, everyone must set up 2FA again.
# (If empty, a key derived from JWT_SECRET is used, so changing JWT_SECRET would have the same effect.)
TOTP_ENCRYPTION_KEY=change-me-openssl-rand-hex-32
# Invitation links expire after this many days.
INVITE_EXPIRY_DAYS=7
# Public address used in invitation links (defaults to https://ASTRA_DOMAIN, then the browser's address).
PUBLIC_URL=

# ---- Public deployment (docker-compose.prod.yml) ----
# Domain pointing at the server; Caddy gets an HTTPS certificate for it automatically.
ASTRA_DOMAIN=
# Extra browser origins allowed to call the API directly (same-origin /api needs nothing here).
CORS_ORIGINS=

# ---- Email alerts (SMTP, any provider: Gmail app password, Microsoft 365, SendGrid, Mailgun, SES) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ASTRA Alerts <alerts@yourcompany.com>

# ---- Space-Track (free account at https://www.space-track.org) ----
# Enables automatic import of public CDMs for NORAD-linked twins.
SPACETRACK_USER=
SPACETRACK_PASSWORD=
SPACETRACK_POLL_HOURS=8

# ---- Operator ephemerides (CCSDS OEM) ----
OEM_MAX_POINTS=50000

# ---- Screening & risk thresholds (defaults shown) ----
SCHEDULER_ENABLED=true
CONJ_WINDOW_HOURS=24
CONJ_REPORT_KM=10
PC_HBR_M=15
PC_CRITICAL=1e-4
PC_WARNING=1e-6
PC_TARGET=1e-6
MANOEUVRE_MIN_MISS_KM=1

# ---- Validation (ASTRA vs CDMs) ----
VALIDATION_DAILY=true
VALIDATION_HOUR_UTC=06
VALIDATION_LOOKBACK_DAYS=14

# ---- Backups ----
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=02

# ---- Monitoring ----
GRAFANA_ADMIN_PASSWORD=change-me
# Optional: require this bearer token on /api/metrics instead of network-only access.
METRICS_TOKEN=

# ---- Optional ----
ANTHROPIC_API_KEY=
